{
  "name": "szenario/craft-embedded-posters",
  "type": "craft-plugin",
  "description": "Local poster images for Embedded Assets embeds, so cookie-consent placeholders don't contact YouTube, Vimeo or SoundCloud.",
  "keywords": [
    "craft",
    "cms",
    "craftcms",
    "craft-plugin",
    "embedded-assets",
    "oembed",
    "gdpr",
    "privacy",
    "poster",
    "thumbnail"
  ],
  "license": "MIT",
  "support": {
    "email": "support@szenario.design",
    "issues": "https://github.com/szenario-fordesigners/embedded-posters/issues?state=open",
    "source": "https://github.com/szenario-fordesigners/embedded-posters",
    "docs": "https://github.com/szenario-fordesigners/embedded-posters#readme",
    "rss": "https://github.com/szenario-fordesigners/embedded-posters/releases.atom"
  },
  "require": {
    "php": "^8.2",
    "craftcms/cms": "^5.3.0",
    "spicyweb/craft-embedded-assets": "^5.0"
  },
  "require-dev": {
    "craftcms/ecs": "dev-main",
    "craftcms/phpstan": "dev-main",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "szenario\\craftembeddedposters\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "szenario\\craftembeddedposters\\tests\\": "tests/"
    }
  },
  "extra": {
    "handle": "embedded-posters",
    "name": "Embedded Posters",
    "developer": "szenario",
    "developerUrl": "https://www.szenario-design.com/",
    "documentationUrl": "https://github.com/szenario-fordesigners/embedded-posters#readme",
    "changelogUrl": "https://github.com/szenario-fordesigners/embedded-posters/blob/main/CHANGELOG.md",
    "class": "szenario\\craftembeddedposters\\EmbeddedPosters"
  },
  "scripts": {
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --ansi --fix",
    "phpstan": "phpstan --memory-limit=1G",
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.2"
    },
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true
    }
  }
}
