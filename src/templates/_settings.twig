{# @var settings \szenario\craftembeddedposters\models\Settings #}
{% import '_includes/forms.twig' as forms %}

{% macro configWarning(setting) -%}
    {{ 'This is being overridden by the `{setting}` config setting.'|t('embedded-posters', { setting: setting })|markdown(inlineOnly=true) }}
{%- endmacro %}

{% set volumeOptions = [{ label: 'The embed’s own volume'|t('embedded-posters'), value: '' }]|merge(
    craft.app.volumes.allVolumes|map(v => { label: v.name, value: v.handle })
) %}

{{ forms.selectField({
    label: 'Volume'|t('embedded-posters'),
    instructions: 'Where posters are stored. A volume of their own keeps them out of editors’ way and away from plugins that process every new image. Existing posters are moved by a queue job after a change.'|t('embedded-posters'),
    id: 'volume',
    name: 'volume',
    options: volumeOptions,
    value: settings.volume,
    errors: settings.getErrors('volume'),
    warning: config.volume is defined ? _self.configWarning('volume'),
}) }}

{{ forms.textField({
    label: 'Folder'|t('embedded-posters'),
    instructions: 'Folder inside that volume. Leave empty for the volume root. Existing posters are moved by a queue job after a change.'|t('embedded-posters'),
    id: 'folder',
    name: 'folder',
    value: settings.folder,
    errors: settings.getErrors('folder'),
    warning: config.folder is defined ? _self.configWarning('folder'),
}) }}
